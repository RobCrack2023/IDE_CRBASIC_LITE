StationName=Diagnostico
ServerHost=loggerip.ingproy.com
ServerPort=6786
PakBusAddress=1
Public I_mA, V_shunt
Units I_mA = mA
DataTable(Diag420, True, 1440)
    DataInterval(0, 1, Min, 0)
    Sample(1, I_mA, FP2)
    Sample(1, V_shunt, FP2)
EndTable
BeginProg
    Scan(2, Sec, 0, 0)
        AIChannel(I_mA, 1)      ' canal I1
        AIChannel(V_shunt, 1)   ' el mismo canal, crudo en volts
    NextScan
EndProg



