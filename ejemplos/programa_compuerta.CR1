'==============================================================
' OptaPakBus — Control de compuerta con sensor ultrasonico RIKA
' Arduino Opta / firmware OptaPakBus v1.3.9+
'
' Hardware:
'   I1 (A0/AI1) - Sensor ultrasonico RIKA, 4-20mA
'                 Mas LEJOS del sensor = compuerta mas CERRADA
'                 Mas CERCA del sensor  = compuerta mas ABIERTA
'   DO1 - Rele de APERTURA (contactor "abrir")
'   DO2 - Rele de CIERRE   (contactor "cerrar")
'
' Operacion (desde la plataforma, vista Public):
'   - Escribir MoverCm = +N  -> abre N centimetros
'   - Escribir MoverCm = -N  -> cierra N centimetros
'   - Escribir Parar   = 1   -> detiene el movimiento en curso
'   - Moviendo indica el estado: 0=detenido, 1=abriendo, 2=cerrando
'
' ══════════════════════════════════════════════════════════════
' CALIBRACION OBLIGATORIA ANTES DE USAR (ver Consts mas abajo):
'   1. Dist_Mult / Dist_Off: segun el rango 4-20mA del sensor RIKA
'      (dato de fabrica, hoja tecnica del sensor).
'   2. Dist_Cerrada_cm: con la compuerta FISICAMENTE CERRADA,
'      anotar la distancia que reporta el sensor (Public Dist_mA
'      convertido a cm, o medir con el sensor directamente).
'   3. AlturaMax_cm: recorrido total de la compuerta, de cerrada
'      a completamente abierta, en centimetros.
' ══════════════════════════════════════════════════════════════
'
' Limitaciones del parser Opta: expresiones completas (+-*/,
' parentesis, Abs/INT/Sqr), condiciones Var <op> Var|Const,
' If/ElseIf/Else/EndIf hasta 2 niveles. Max 16 Const, 32
' instrucciones, 4 tablas, 64 variables.
'==============================================================

StationName=Compuerta_1

'-- Config de red (firmware v1.6.0+) -----------------------------
' El equipo toma de AQUI su destino de red: un mismo firmware sirve
' para todos los equipos; cada .CR1 lleva su propia config.
' Estos valores DEBEN coincidir con el logger configurado en el
' servidor (mismo ServerPort y PakBus Address).
' IMPORTANTE: sin la linea ServerPort= el equipo se considera NO
' provisionado y se conecta al puerto de PROVISION (4789), no aqui.
' (El firmware < v1.6.0 ignora estas lineas sin dar error.)
ServerHost=loggerip.ingproy.com   ' dominio/IP del servidor
ServerPort=6786                    ' puerto operativo de ESTE logger
PakBusAddress=1                    ' PakBus Address de ESTE logger (= node_id en el server)

'-- Calibracion del sensor 4-20mA → distancia (cm) --------------
' Formula standard: dist_cm = mA * Mult + Off, donde:
'   Mult = (DistMax_cm - DistMin_cm) / 16
'   Off  = DistMin_cm - 4 * Mult
' EJEMPLO para un RIKA con rango 30-500cm (AJUSTAR a tu sensor real):
'   Mult = (500-30)/16 = 29.375   Off = 30 - 4*29.375 = -87.5
Const Dist_Mult = 29.375       ' cm por mA — AJUSTAR segun datasheet
Const Dist_Off  = -87.5        ' cm — AJUSTAR segun datasheet

'-- Calibracion de la compuerta ----------------------------------
Const Dist_Cerrada_cm = 60.0  ' distancia del sensor con compuerta CERRADA — MEDIR Y AJUSTAR
Const AlturaMin_cm     = 0.0   ' compuerta cerrada = altura 0
Const AlturaMax_cm     = 60.0 ' recorrido total (cerrada→abierta) — AJUSTAR

'-- Seguridad -----------------------------------------------------
Const Deadband_cm     = 2.0    ' tolerancia para considerar "llegó"
Const MaxMoveTime_seg = 120.0  ' corte de seguridad: max tiempo moviendose
Const ScanInterval_seg = 2.0   ' DEBE coincidir con el Scan() de abajo
Const SensorMin_mA    = 3.5    ' fuera de este rango = sensor con falla
Const SensorMax_mA    = 20.5

'-- Sensor --------------------------------------------------------
Public Dist_mA
Units Dist_mA = mA

'-- Estado y control ------------------------------------------------
Public Altura_cm            ' altura actual de la compuerta (0=cerrada)
Public MoverCm               ' ORDEN: +N abre N cm, -N cierra N cm (SetValues)
Public Parar                 ' ORDEN: 1 = detener movimiento (SetValues)
Public Moviendo              ' ESTADO: 0=detenido, 1=abriendo, 2=cerrando
Public ObjetivoAltura_cm     ' altura objetivo del movimiento en curso
Public SensorFalla           ' 1 = sensor fuera de rango (0 o >20.5mA)
Dim ObjetivoAlto_cm           ' objetivo - deadband (limite al abrir)
Dim ObjetivoBajo_cm           ' objetivo + deadband (limite al cerrar)
Dim MoveTimer_seg             ' segundos transcurridos del movimiento actual

'-- Reles de control (asignados explicitamente via PortSet mas abajo) --
Public DO1   ' Rele de APERTURA — asignado a rele fisico #1
Public DO2   ' Rele de CIERRE   — asignado a rele fisico #2

'==============================================================
'  TABLA: historico cada 1 minuto
'==============================================================
DataTable(Registro, True, 10080)
    DataInterval(0, 1, Min, 0)
    Sample(1, Altura_cm, FP2)
    Sample(1, ObjetivoAltura_cm, FP2)
    Sample(1, Moviendo, FP2)
    Sample(1, DO1, FP2)
    Sample(1, DO2, FP2)
    Sample(1, SensorFalla, FP2)
EndTable

'==============================================================
'  PROGRAMA PRINCIPAL
'==============================================================

BeginProg
    Scan(2, Sec, 0, 0)

        ' Asignacion EXPLICITA de hardware — no depende del orden de
        ' declaracion ni de que la variable se llame "DO1"/"DO2".
        AIChannel(Dist_mA, 1)   ' Dist_mA usa el canal I1 (A0)
        PortSet(DO1, 0, 1)      ' DO1 usa el rele fisico #1
        PortSet(DO2, 0, 2)      ' DO2 usa el rele fisico #2

        '-- 1. Altura actual desde el sensor -------------------------
        Altura_cm = Dist_Cerrada_cm - (Dist_mA * Dist_Mult + Dist_Off)

        '-- 2. Deteccion de falla del sensor --------------------------
        If (Dist_mA < SensorMin_mA) Then SensorFalla = 1
        If (Dist_mA > SensorMax_mA) Then SensorFalla = 1
        If (Dist_mA >= SensorMin_mA) AND (Dist_mA <= SensorMax_mA) Then SensorFalla = 0
        If (SensorFalla <> 0) Then Moviendo = 0
        If (SensorFalla <> 0) Then MoverCm = 0

        '-- 3. Nueva orden de movimiento (solo si esta detenido) ------
        If (Moviendo = 0) AND (MoverCm <> 0) Then ObjetivoAltura_cm = Altura_cm + MoverCm
        If (ObjetivoAltura_cm < AlturaMin_cm) Then ObjetivoAltura_cm = AlturaMin_cm
        If (ObjetivoAltura_cm > AlturaMax_cm) Then ObjetivoAltura_cm = AlturaMax_cm
        ObjetivoAlto_cm = ObjetivoAltura_cm - Deadband_cm
        ObjetivoBajo_cm = ObjetivoAltura_cm + Deadband_cm

        '-- 4. Iniciar movimiento con direccion ------------------------
        If (Moviendo = 0) AND (MoverCm > 0) Then Moviendo = 1
        If (Moviendo = 0) AND (MoverCm < 0) Then Moviendo = 2
        If (MoverCm <> 0) Then MoveTimer_seg = 0
        If (MoverCm <> 0) Then MoverCm = 0

        '-- 5. Temporizador de seguridad --------------------------------
        If (Moviendo <> 0) Then MoveTimer_seg = MoveTimer_seg + ScanInterval_seg
        If (MoveTimer_seg > MaxMoveTime_seg) Then Moviendo = 0
        If (MoveTimer_seg > MaxMoveTime_seg) Then MoveTimer_seg = 0

        '-- 6. Detectar llegada al objetivo (con banda muerta) ---------
        If (Moviendo = 1) AND (Altura_cm > ObjetivoAlto_cm) Then Moviendo = 0
        If (Moviendo = 2) AND (Altura_cm < ObjetivoBajo_cm) Then Moviendo = 0

        '-- 7. Parada manual --------------------------------------------
        If (Parar <> 0) Then Moviendo = 0
        If (Parar <> 0) Then MoveTimer_seg = 0
        If (Parar <> 0) Then MoverCm = 0
        If (Parar <> 0) Then Parar = 0

        '-- 8. Accionar reles segun estado -------------------------------
        If (Moviendo = 1) Then DO1 = 1
        If (Moviendo <> 1) Then DO1 = 0
        If (Moviendo = 2) Then DO2 = 1
        If (Moviendo <> 2) Then DO2 = 0

        CallTable Registro

    NextScan
EndProg
